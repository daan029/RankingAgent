# Reddit API app: https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RankingAgent/0.1 by <your-reddit-username>

# YouTube Data API v3 OAuth client secrets JSON (Google Cloud Console)
YOUTUBE_CLIENT_SECRETS_PATH=./youtube_client_secrets.json
# unlisted | public | private
YOUTUBE_PRIVACY_STATUS=unlisted

# Only set true on a dev machine behind an SSL-inspecting corporate proxy
# where yt-dlp/Python cert verification fails. Leave false on the real
# deployment (home) laptop.
YTDLP_NO_CHECK_CERTIFICATE=false
